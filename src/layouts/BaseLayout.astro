---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  currentPage?: string;
}

const { title, description = "Festival de Fútbol BabyFútbol Colanta - La Cruz, Nariño 2025", currentPage } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
    
    <!-- PhotoSwipe CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.css">
    
    <!-- Global styles -->
    <link rel="stylesheet" href="/src/styles/global.css">
  </head>
  <body class="bg-gray-50 text-gray-900">
    <Navbar currentPage={currentPage} />
    
    <main>
      <slot />
    </main>
    
    <Footer />
    
    <!-- PhotoSwipe JS -->
    <script type="module">
      // Hacer PhotoSwipe disponible globalmente
      import PhotoSwipeLightbox from 'https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe-lightbox.esm.js';
      window.PhotoSwipeLightbox = PhotoSwipeLightbox;
    </script>
  </body>
</html>