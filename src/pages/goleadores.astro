---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Tabla de Goleadores - Festival BabyFútbol Colanta 2025" currentPage="goleadores">
  <div class="py-8 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-6">
        <h1 class="text-3xl md:text-4xl font-display font-bold text-gray-900 mb-1">
          Tabla de Goleadores
        </h1>
        <p class="text-sm md:text-base text-gray-600">
          Máximos artilleros — selecciona la fase y filtra por jugador o equipo
        </p>
      </div>

      <!-- Tabs + search -->
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
        <div class="flex gap-2" role="tablist" aria-label="Fases">
          <button class="phase-btn px-4 py-2 rounded-lg bg-primary-600 text-white" data-phase="groups" aria-pressed="true">Fase de Grupos</button>
          <button class="phase-btn px-4 py-2 rounded-lg bg-gray-100 text-gray-800" data-phase="octavos" aria-pressed="false">Octavos</button>
          <button class="phase-btn px-4 py-2 rounded-lg bg-gray-100 text-gray-800" data-phase="cuartos" aria-pressed="false">Cuartos</button>
        </div>

        <div class="flex items-center gap-2">
          <input id="scorer-search" type="search" placeholder="Buscar jugador o equipo..." class="px-3 py-2 border rounded-lg w-64 focus:outline-none focus:ring-2 focus:ring-primary-300" />
          <select id="sort-by" class="px-3 py-2 border rounded-lg">
            <option value="goals_desc">Goles (más → menos)</option>
            <option value="goals_asc">Goles (menos → más)</option>
            <option value="name_asc">Nombre (A → Z)</option>
            <option value="name_desc">Nombre (Z → A)</option>
          </select>
        </div>
      </div>

      <!-- STATS arriba -->
      <div id="stats-top" class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div id="top-scorer-card" class="bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-2xl p-4 text-white shadow-neomorphism flex items-center gap-4">
          <div id="top-scorer-escudo" class="w-14 h-14 rounded-full bg-white/20 overflow-hidden flex items-center justify-center"></div>
          <div>
            <p class="text-xs text-yellow-100">Máximo goleador</p>
            <h3 id="top-scorer-name" class="text-lg font-bold">—</h3>
            <p id="top-scorer-team" class="text-sm text-yellow-200">—</p>
          </div>
          <div class="ml-auto text-3xl font-bold" id="top-scorer-goals">0</div>
        </div>

        <div id="total-goals-card" class="bg-gradient-to-br from-green-500 to-green-600 rounded-2xl p-4 text-white shadow-neomorphism">
          <p class="text-xs text-green-100">Total de goles (fase)</p>
          <div id="total-goals" class="text-2xl font-bold">0</div>
        </div>

        <div id="avg-goals-card" class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl p-4 text-white shadow-neomorphism">
          <p class="text-xs text-blue-100">Promedio por jugador</p>
          <div id="avg-goals" class="text-2xl font-bold">0.0</div>
        </div>
      </div>

      <!-- Table -->
      <div class="bg-white rounded-2xl shadow-neomorphism overflow-hidden">
        <div id="table-header" class="p-4 bg-gradient-to-r from-primary-600 to-secondary-600 text-white">
          <h2 id="phase-title" class="text-lg font-bold">Fase de Grupos</h2>
          <p id="phase-sub" class="text-sm opacity-90">Goleadores</p>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">#</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Jugador</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Equipo</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Goles</th>
              </tr>
            </thead>
            <tbody id="scorers-tbody" class="bg-white divide-y divide-gray-100">
              <!-- rows -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <style>
    .shadow-neomorphism { box-shadow: 10px 10px 24px rgba(15,23,42,0.06), -6px -6px 18px rgba(255,255,255,0.6); }
    @media (min-width: 1024px) {
      .table-head th { position: sticky; top: 0; background: rgba(255,255,255,0.95); backdrop-filter: blur(4px); z-index: 1; }
    }
  </style>

  <script type="module">
    (async () => {
      const URL = '/data/scorers.json'; // tu JSON optimizado
      const FALLBACK = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80"><rect width="100%" height="100%" fill="%23e5e7eb"/></svg>';

      // comparadores
      const byGoalsDesc = (a,b) => (b.goals - a.goals) || a.name.localeCompare(b.name);
      const byGoalsAsc = (a,b) => (a.goals - b.goals) || a.name.localeCompare(b.name);
      const byNameAsc = (a,b) => a.name.localeCompare(b.name);
      const byNameDesc = (a,b) => b.name.localeCompare(a.name);

      // computePositions **no reordena**: asigna posiciones sobre la lista ya ordenada
      function computePositions(sortedList) {
        let prevGoals = null;
        let prevPos = 0;
        for (let i = 0; i < sortedList.length; i++) {
          const item = sortedList[i];
          if (item.goals === prevGoals) {
            item._position = prevPos;
          } else {
            item._position = i + 1;
            prevPos = i + 1;
            prevGoals = item.goals;
          }
        }
        return sortedList;
      }

      function safeUrl(u){ return u || FALLBACK; }

      // escape de atributos para evitar romper HTML si hay comillas
      function escapeAttr(str) {
        if (str == null) return '';
        return String(str).replace(/&/g,'&amp;').replace(/"/g, '&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      }

      // debounce util
      function debounce(fn, wait=250){
        let t;
        return (...args) => { clearTimeout(t); t = setTimeout(()=>fn(...args), wait); };
      }

      try {
        const resp = await fetch(URL);
        if (!resp.ok) throw new Error('scorers.json not found');
        const data = await resp.json();

        const teams = (data.teams && typeof data.teams === 'object') ? data.teams : {};
        const phases = data.scorers || {};
        const availablePhases = ['groups','octavos','cuartos'].filter(k => Array.isArray(phases[k]));

        // DOM refs
        const tbody = document.getElementById('scorers-tbody');
        const phaseTitle = document.getElementById('phase-title');
        const phaseSub = document.getElementById('phase-sub');
        const topEscudo = document.getElementById('top-scorer-escudo');
        const topName = document.getElementById('top-scorer-name');
        const topTeam = document.getElementById('top-scorer-team');
        const topGoals = document.getElementById('top-scorer-goals');
        const totalGoalsEl = document.getElementById('total-goals');
        const avgGoalsEl = document.getElementById('avg-goals');
        const searchInput = document.getElementById('scorer-search');
        const sortSelect = document.getElementById('sort-by');

        // phase buttons
        document.querySelectorAll('.phase-btn').forEach(btn => {
          const p = btn.dataset.phase;
          if (!availablePhases.includes(p)) btn.disabled = true;
          btn.addEventListener('click', () => {
            document.querySelectorAll('.phase-btn').forEach(b => {
              b.classList.remove('bg-primary-600','text-white');
              b.classList.add('bg-gray-100','text-gray-800');
              b.setAttribute('aria-pressed','false');
            });
            btn.classList.add('bg-primary-600','text-white');
            btn.classList.remove('bg-gray-100','text-gray-800');
            btn.setAttribute('aria-pressed','true');
            renderPhase(p);
          });
        });

        const initialPhase = availablePhases.includes('groups') ? 'groups' : (availablePhases[0] || null);
        if (!initialPhase) {
          tbody.innerHTML = '<tr><td colspan="4" class="px-4 py-8 text-center text-gray-600">No hay datos de goleadores.</td></tr>';
          return;
        }

        function hydrate(entry) {
          const teamId = entry.teamId || null;
          const teamObj = teamId ? teams[teamId] : null;
          return {
            ...entry,
            name: entry.name || '—',
            teamName: (teamObj && teamObj.name) || entry.team || '—',
            escudo: (teamObj && teamObj.escudo) || null
          };
        }

        // render function: filtra, ordena (según select), asigna posiciones y renderiza
        function renderPhase(phaseKey) {
          const rawList = (phases[phaseKey] || []).map(hydrate);
          const q = (searchInput.value || '').trim().toLowerCase();

          // filtro por búsqueda
          let filtered = rawList.filter(x => {
            if (!q) return true;
            return x.name.toLowerCase().includes(q) || (x.teamName || '').toLowerCase().includes(q);
          });

          // ordenar según select
          const sortMode = sortSelect.value;
          if (sortMode === 'goals_desc') filtered.sort(byGoalsDesc);
          else if (sortMode === 'goals_asc') filtered.sort(byGoalsAsc);
          else if (sortMode === 'name_asc') filtered.sort(byNameAsc);
          else if (sortMode === 'name_desc') filtered.sort(byNameDesc);

          // asignar posiciones (respeta empates)
          const withPositions = computePositions(filtered);

          // actualizar header
          const niceName = phaseKey === 'groups' ? 'Fase de Grupos' : phaseKey === 'octavos' ? 'Octavos' : 'Cuartos';
          phaseTitle.textContent = niceName;
          phaseSub.textContent = `Goleadores — ${withPositions.length} jugadores`;

          // render tabla
          if (withPositions.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="px-4 py-8 text-center text-gray-600">No hay registros.</td></tr>';
          } else {
            // Construir filas usando nodos DOM para evitar romper atributos con datos mal formados
            tbody.textContent = '';
            const frag = document.createDocumentFragment();

            withPositions.forEach(p => {
              const escUrl = safeUrl(p.escudo);
              const pos = p._position;

              const tr = document.createElement('tr');
              tr.className = 'hover:bg-gray-50 transition-colors';

              // Badge cell
              const tdBadge = document.createElement('td');
              tdBadge.className = 'px-4 py-3 whitespace-nowrap';
              const badgeDiv = document.createElement('div');
              badgeDiv.className = 'w-9 h-9 rounded-full flex items-center justify-center font-bold';
              if (pos === 1) badgeDiv.classList.add('bg-yellow-400');
              else if (pos === 2) badgeDiv.classList.add('bg-gray-300');
              else if (pos === 3) badgeDiv.classList.add('bg-orange-400');
              else badgeDiv.classList.add('bg-primary-100');
              badgeDiv.textContent = String(pos);
              tdBadge.appendChild(badgeDiv);

              // Player cell
              const tdPlayer = document.createElement('td');
              tdPlayer.className = 'px-4 py-3';
              const playerWrap = document.createElement('div');
              playerWrap.className = 'flex items-center gap-3';

              const imgEl = document.createElement('img');
              imgEl.src = escUrl;
              imgEl.alt = (p.teamName ? String(p.teamName) + ' escudo' : '');
              imgEl.className = 'w-9 h-9 rounded-full object-cover';
              imgEl.onerror = function(){ this.onerror=null; this.src = FALLBACK; };

              const infoDiv = document.createElement('div');
              const nameDiv = document.createElement('div');
              nameDiv.className = 'text-sm font-medium text-gray-900';
              nameDiv.textContent = p.name != null ? String(p.name) : '—';
              const posDiv = document.createElement('div');
              posDiv.className = 'text-xs text-gray-500';
              posDiv.textContent = '#' + (p.position ?? '');

              infoDiv.appendChild(nameDiv);
              infoDiv.appendChild(posDiv);

              playerWrap.appendChild(imgEl);
              playerWrap.appendChild(infoDiv);
              tdPlayer.appendChild(playerWrap);

              // Team cell
              const tdTeam = document.createElement('td');
              tdTeam.className = 'px-4 py-3';
              const teamDiv = document.createElement('div');
              teamDiv.className = 'text-sm text-gray-700';
              teamDiv.textContent = p.teamName != null ? String(p.teamName) : '';
              tdTeam.appendChild(teamDiv);

              // Goals cell
              const tdGoals = document.createElement('td');
              tdGoals.className = 'px-4 py-3 text-center';
              const goalsDiv = document.createElement('div');
              goalsDiv.className = 'text-2xl font-bold text-primary-600';
              goalsDiv.textContent = String(p.goals != null ? p.goals : '0');
              tdGoals.appendChild(goalsDiv);

              tr.appendChild(tdBadge);
              tr.appendChild(tdPlayer);
              tr.appendChild(tdTeam);
              tr.appendChild(tdGoals);

              frag.appendChild(tr);
            });

            tbody.appendChild(frag);
          }

          // stats
          const totalGoals = withPositions.reduce((s,x) => s + (Number(x.goals)||0), 0);
          const avg = withPositions.length ? (totalGoals / withPositions.length) : 0;
          const top = withPositions.length ? withPositions[0] : null;

          totalGoalsEl.textContent = totalGoals;
          avgGoalsEl.textContent = avg.toFixed(1);

          if (top) {
            topName.textContent = top.name;
            topTeam.textContent = top.teamName;
            topGoals.textContent = top.goals;
            topEscudo.textContent = '';
            const topImg = document.createElement('img');
            topImg.src = safeUrl(top.escudo);
            topImg.alt = (top.teamName ? String(top.teamName) + ' escudo' : '');
            topImg.className = 'w-14 h-14 object-cover';
            topImg.onerror = function(){ this.onerror=null; this.src = FALLBACK; };
            topEscudo.appendChild(topImg);
          } else {
            topName.textContent = '—';
            topTeam.textContent = '';
            topGoals.textContent = '0';
            topEscudo.textContent = '';
          }
        }

        // inicial render
        renderPhase(initialPhase);
        // estilizar boton inicial
        const initBtn = document.querySelector(`.phase-btn[data-phase="${initialPhase}"]`);
        if (initBtn) {
          document.querySelectorAll('.phase-btn').forEach(b => { b.classList.remove('bg-primary-600','text-white'); b.classList.add('bg-gray-100','text-gray-800'); });
          initBtn.classList.add('bg-primary-600','text-white');
        }

        // interacciones
        const debouncedRender = debounce(() => {
          const active = document.querySelector('.phase-btn.bg-primary-600[data-phase]')?.dataset?.phase || initialPhase;
          renderPhase(active);
        }, 250);

        searchInput.addEventListener('input', debouncedRender);
        sortSelect.addEventListener('change', () => {
          const active = document.querySelector('.phase-btn.bg-primary-600[data-phase]')?.dataset?.phase || initialPhase;
          renderPhase(active);
        });

      } catch (err) {
        console.error('Error loading scorers.json', err);
        const tbody = document.getElementById('scorers-tbody');
        if (tbody) tbody.innerHTML = '<tr><td colspan="4" class="px-4 py-8 text-center text-red-600">Error al cargar los goleadores. Revisa /data/scorers.json</td></tr>';
      }
    })();
  </script>
</BaseLayout>
