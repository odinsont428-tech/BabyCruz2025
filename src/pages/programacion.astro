---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Programación - Festival BabyFútbol Colanta 2025" currentPage="programacion">
  <div class="py-8 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-gray-900 mb-4">
          Programación del Torneo
        </h1>
        <p class="text-xl text-gray-600">
          Consulta todos los partidos del Festival BabyFútbol Colanta 2025
        </p>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap justify-center gap-2 mb-8" id="date-filter">
        <!-- Los botones de filtro se cargarán dinámicamente -->
      </div>

      <!-- Matches Container -->
      <div id="matches-container" class="space-y-8">
        <!-- Los partidos se cargarán aquí -->
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const response = await fetch('/data/matches.json');
      const data = await response.json();
      
      const dateFilter = document.getElementById('date-filter');
      const matchesContainer = document.getElementById('matches-container');
      
      if (!dateFilter || !matchesContainer) return;

      // Crear botones de filtro por fecha
      const allDates = data.matches.map(match => match.date);
      
      // Botón para mostrar todos
      const allButton = document.createElement('button');
      allButton.className = 'px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors filter-btn active';
      allButton.textContent = 'Todas las fechas';
      allButton.dataset.date = 'all';
      dateFilter.appendChild(allButton);
      
      // Botones para cada fecha específica
      allDates.forEach(date => {
        const button = document.createElement('button');
        button.className = 'px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors filter-btn';
        button.textContent = new Date(date).toLocaleDateString('es-CO', { 
          weekday: 'short', 
          month: 'short', 
          day: 'numeric' 
        });
        button.dataset.date = date;
        dateFilter.appendChild(button);
      });
      
      // Función para mostrar partidos
      function showMatches(selectedDate = 'all') {
        const matchesToShow = selectedDate === 'all' ? data.matches : data.matches.filter(match => match.date === selectedDate);
        
        matchesContainer.innerHTML = matchesToShow.map(matchDay => `
          <div class="bg-white rounded-2xl shadow-neomorphism overflow-hidden">
            <!-- Header del día -->
            <div class="bg-gradient-to-r from-primary-600 to-secondary-600 text-white p-6">
              <h2 class="text-2xl font-display font-bold">
                ${new Date(matchDay.date).toLocaleDateString('es-CO', { 
                  weekday: 'long', 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </h2>
              <p class="text-primary-100">${matchDay.venue}</p>
            </div>
            
            <!-- Lista de partidos -->
            <div class="divide-y divide-gray-200">
              ${matchDay.games.map(game => `
                <div class="p-6 hover:bg-gray-50 transition-colors">
                  <div class="flex items-center justify-between">
                    <!-- Equipo local -->
                    <div class="flex-1 text-right pr-4">
                      <h3 class="font-semibold text-gray-900 text-lg">${game.homeTeam}</h3>
                    </div>
                    
                    <!-- Información central -->
                    <div class="flex-shrink-0 text-center px-6">
                      <div class="bg-primary-100 rounded-lg px-4 py-2">
                        <div class="text-2xl font-bold text-primary-600">VS</div>
                        <div class="text-sm text-gray-600 mt-1">${game.time}</div>
                        <div class="mt-2">
                          <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full 
                            ${game.group === 'A' ? 'bg-red-100 text-red-800' : 
                              game.group === 'B' ? 'bg-blue-100 text-blue-800' :
                              game.group === 'C' ? 'bg-green-100 text-green-800' :
                              game.group === 'D' ? 'bg-yellow-100 text-yellow-800' :
                              game.group === 'E' ? 'bg-purple-100 text-purple-800' :
                              'bg-pink-100 text-pink-800'}">
                            Grupo ${game.group}
                          </span>
                        </div>
                      </div>
                    </div>
                    
                    <!-- Equipo visitante -->
                    <div class="flex-1 text-left pl-4">
                      <h3 class="font-semibold text-gray-900 text-lg">${game.awayTeam}</h3>
                    </div>
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
        `).join('');
      }
      
      // Mostrar todos los partidos inicialmente
      showMatches();
      
      // Event listeners para los botones de filtro
      dateFilter.addEventListener('click', (e) => {
        if (e.target.classList.contains('filter-btn')) {
          // Remover clase active de todos los botones
          dateFilter.querySelectorAll('.filter-btn').forEach(btn => {
            btn.classList.remove('active', 'bg-primary-600', 'text-white');
            btn.classList.add('bg-gray-200', 'text-gray-700');
          });
          
          // Agregar clase active al botón clickeado
          e.target.classList.add('active', 'bg-primary-600', 'text-white');
          e.target.classList.remove('bg-gray-200', 'text-gray-700');
          
          // Mostrar partidos filtrados
          showMatches(e.target.dataset.date);
        }
      });
      
    } catch (error) {
      console.error('Error loading matches:', error);
      document.getElementById('matches-container').innerHTML = `
        <div class="text-center py-12">
          <p class="text-red-600">Error al cargar la programación. Por favor, intenta nuevamente.</p>
        </div>
      `;
    }
  });
</script>
</BaseLayout>