---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Galerías de Fotos - Festival BabyFútbol Colanta 2025" currentPage="galerias">
  <div class="py-8 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-gray-900 mb-4">
          Galerías de Fotos
        </h1>
        <p class="text-xl text-gray-600">
          Revive los mejores momentos del Festival BabyFútbol Colanta 2025
        </p>
      </div>

      <!-- Galleries Container -->
      <div id="galleries-container" class="space-y-12">
        <!-- Loading state -->
        <div class="text-center py-12">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600 mx-auto"></div>
          <p class="mt-4 text-gray-600">Cargando galerías...</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Función para inicializar PhotoSwipe
  function initPhotoSwipe() {
    console.log('Inicializando PhotoSwipe...');
    
    // Verificar que PhotoSwipe esté disponible
    if (!window.PhotoSwipeLightbox) {
      console.error('PhotoSwipeLightbox no está disponible');
      return;
    }

    // Buscar todas las galerías
    const galleries = document.querySelectorAll('[data-gallery]');
    
    galleries.forEach((gallery, index) => {
      console.log(`Configurando galería ${index + 1}`);
      
      // Crear una instancia de PhotoSwipe para cada galería
      const lightbox = new PhotoSwipeLightbox({
        gallery: gallery,
        children: 'a.gallery-item',
        
        // Configuración de PhotoSwipe
        pswpModule: () => import('https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.esm.js'),
        
        // Opciones
        bgOpacity: 0.9,
        loop: true,
        zoom: true,
        preload: [1, 3],
        showHideAnimationType: 'zoom',
        
        // Configurar el padding
        paddingFn: (viewportSize) => {
          return {
            top: 30,
            bottom: 30,
            left: 70,
            right: 70
          };
        }
      });

      // Agregar captions
      lightbox.on('uiRegister', function () {
        lightbox.pswp.ui.registerElement({
          name: 'custom-caption',
          order: 9,
          isButton: false,
          appendTo: 'root',
          html: 'Caption text',
          onInit: (el, pswp) => {
            lightbox.pswp.on('change', () => {
              const currSlideElement = lightbox.pswp.currSlide?.data.element;
              let captionHTML = '';
              
              if (currSlideElement) {
                const captionElement = currSlideElement.querySelector('.image-caption');
                if (captionElement) {
                  captionHTML = captionElement.textContent || '';
                }
              }
              
              el.innerHTML = captionHTML ? 
                `<div class="pswp__caption__center">${captionHTML}</div>` : '';
            });
          }
        });
      });

      // Event listeners
      lightbox.on('beforeOpen', () => {
        console.log('PhotoSwipe se está abriendo...');
      });

      lightbox.on('afterInit', () => {
        console.log(`PhotoSwipe inicializado para galería ${index + 1}`);
      });

      // Inicializar
      lightbox.init();
    });
  }

  // Función para cargar y mostrar galerías
  async function loadGalleries() {
    try {
      console.log('Cargando datos de galerías...');
      const response = await fetch('/data/galleries.json');
      
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      const data = await response.json();
      console.log('Datos cargados:', data);
      
      const galleriesContainer = document.getElementById('galleries-container');
      
      if (!galleriesContainer) {
        console.error('Container de galerías no encontrado');
        return;
      }

      // Renderizar galerías
      galleriesContainer.innerHTML = data.galleries.map((gallery, galleryIndex) => `
        <div class="bg-white rounded-2xl shadow-neomorphism overflow-hidden">
          <!-- Header de la galería -->
          <div class="bg-gradient-to-r from-primary-600 to-secondary-600 text-white p-6">
            <h2 class="text-2xl font-display font-bold">${gallery.title}</h2>
            <p class="text-primary-100 mt-2">${gallery.description}</p>
            <p class="text-primary-200 text-sm mt-1">
              ${new Date(gallery.date).toLocaleDateString('es-CO', { 
                weekday: 'long', 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
              })}
            </p>
          </div>
          
          <!-- Grid de imágenes -->
          <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-gallery="gallery-${gallery.id}">
              ${gallery.images.map((image, imageIndex) => `
                <a href="${image.src}" 
                   class="gallery-item block aspect-[4/3] overflow-hidden rounded-xl shadow-neomorphism-sm hover:shadow-lg transition-all duration-300 hover:scale-105 cursor-pointer group"
                   data-pswp-width="1200" 
                   data-pswp-height="800">
                  <img src="${image.thumbnail}" 
                       alt="${image.alt}"
                       loading="lazy"
                       class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                  <span class="image-caption sr-only">${image.caption}</span>
                </a>
              `).join('')}
            </div>
          </div>
        </div>
      `).join('');

      console.log('Galerías renderizadas, inicializando PhotoSwipe...');
      
      // Esperar un momento para que el DOM se actualice
      setTimeout(() => {
        initPhotoSwipe();
      }, 100);

    } catch (error) {
      console.error('Error loading galleries:', error);
      const galleriesContainer = document.getElementById('galleries-container');
      if (galleriesContainer) {
        galleriesContainer.innerHTML = `
          <div class="text-center py-12">
            <div class="text-red-600 mb-4">
              <svg class="w-12 h-12 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
              </svg>
            </div>
            <p class="text-red-600 font-semibold">Error al cargar las galerías</p>
            <p class="text-gray-600 mt-2">Por favor, intenta recargar la página</p>
            <button onclick="window.location.reload()" class="mt-4 px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
              Recargar
            </button>
          </div>
        `;
      }
    }
  }

  // Esperar a que PhotoSwipe esté disponible y luego cargar galerías
  function waitForPhotoSwipe() {
    if (window.PhotoSwipeLightbox) {
      console.log('PhotoSwipe disponible, cargando galerías...');
      loadGalleries();
    } else {
      console.log('Esperando PhotoSwipe...');
      setTimeout(waitForPhotoSwipe, 100);
    }
  }

  // Iniciar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', waitForPhotoSwipe);
  } else {
    waitForPhotoSwipe();
  }
</script>
</BaseLayout>