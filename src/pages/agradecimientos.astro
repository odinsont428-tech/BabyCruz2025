---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Aliados y Colaboradores - Festival BabyFútbol Colanta 2025" currentPage="agradecimientos">
  <div class="py-8 bg-gradient-to-br from-gray-50 to-blue-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="text-center mb-16 relative">
        <div class="absolute inset-0 bg-gradient-to-r from-primary-200 to-secondary-200 rounded-3xl opacity-20 blur-3xl"></div>
        <div class="relative">
          <h1 class="text-5xl md:text-7xl font-display font-bold bg-gradient-to-r from-primary-600 via-secondary-600 to-accent-600 bg-clip-text text-transparent mb-6">
            Nuestros Aliados
          </h1>
          <p class="text-xl md:text-2xl text-gray-700 max-w-4xl mx-auto leading-relaxed">
            Juntos construimos sueños, forjamos campeones y creamos momentos inolvidables para los niños de Colombia
          </p>
          <div class="mt-8 flex justify-center">
            <div class="bg-white rounded-full px-8 py-3 shadow-neomorphism">
              <span class="text-primary-600 font-semibold">🤝 Unidos por el deporte infantil</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Stats -->
      <section class="mb-20">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="group cursor-pointer">
            <div class="bg-white rounded-2xl p-6 shadow-neomorphism hover:shadow-lg transition-all duration-500 hover:scale-105 hover:rotate-1">
              <div class="text-center">
                <div class="w-16 h-16 bg-gradient-to-br from-yellow-400 to-orange-500 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:animate-bounce">
                  <span class="text-2xl">🏆</span>
                </div>
                <div class="text-3xl font-bold text-gray-900 mb-2">25</div>
                <div class="text-sm text-gray-600">Equipos Unidos</div>
              </div>
            </div>
          </div>
          
          <div class="group cursor-pointer">
            <div class="bg-white rounded-2xl p-6 shadow-neomorphism hover:shadow-lg transition-all duration-500 hover:scale-105 hover:-rotate-1">
              <div class="text-center">
                <div class="w-16 h-16 bg-gradient-to-br from-green-400 to-blue-500 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:animate-pulse">
                  <span class="text-2xl">⚽</span>
                </div>
                <div class="text-3xl font-bold text-gray-900 mb-2">350+</div>
                <div class="text-sm text-gray-600">Niños Felices</div>
              </div>
            </div>
          </div>
          
          <div class="group cursor-pointer">
            <div class="bg-white rounded-2xl p-6 shadow-neomorphism hover:shadow-lg transition-all duration-500 hover:scale-105 hover:rotate-1">
              <div class="text-center">
                <div class="w-16 h-16 bg-gradient-to-br from-purple-400 to-pink-500 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:animate-spin">
                  <span class="text-2xl">🌟</span>
                </div>
                <div class="text-3xl font-bold text-gray-900 mb-2">10</div>
                <div class="text-sm text-gray-600">Días de Magia</div>
              </div>
            </div>
          </div>
          
          <div class="group cursor-pointer">
            <div class="bg-white rounded-2xl p-6 shadow-neomorphism hover:shadow-lg transition-all duration-500 hover:scale-105 hover:-rotate-1">
              <div class="text-center">
                <div class="w-16 h-16 bg-gradient-to-br from-red-400 to-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:animate-bounce">
                  <span class="text-2xl">❤️</span>
                </div>
                <div class="text-3xl font-bold text-gray-900 mb-2">∞</div>
                <div class="text-sm text-gray-600">Momentos Únicos</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Aliados Principales con diseño innovador -->
      <section class="mb-20">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-display font-bold text-gray-900 mb-4">
            💫 Aliados Principales
          </h2>
          <p class="text-lg text-gray-600">Quienes hacen posible que los sueños se conviertan en realidad</p>
        </div>
        
        <div id="main-sponsors" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Los aliados principales se cargarán aquí -->
        </div>
      </section>

      <!-- Apoyo Institucional con cards flotantes -->
      <section class="mb-20">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-display font-bold text-gray-900 mb-4">
            
          </h2>
          <p class="text-lg text-gray-600"></p>
        </div>
        
        <div id="institutional-sponsors" class="flex flex-wrap justify-center gap-6">
          <!-- Los aliados institucionales se cargarán aquí -->
        </div>
      </section>

      <!-- Familia Deportiva -->
      <section class="mb-20">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-display font-bold text-gray-900 mb-4">
            
          </h2>
          <p class="text-lg text-gray-600"></p>
        </div>
        
        <div id="sports-sponsors" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          <!-- Las organizaciones deportivas se cargarán aquí -->
        </div>
      </section>

      <!-- Mensaje de Gratitud Interactivo -->
      <section class="relative mb-16">
        <div class="absolute inset-0 bg-gradient-to-r from-primary-600 via-secondary-600 to-accent-600 rounded-3xl opacity-90"></div>
        <div class="absolute inset-0 bg-[url('https://images.pexels.com/photos/114296/pexels-photo-114296.jpeg?auto=compress&cs=tinysrgb&w=1920')] bg-cover bg-center rounded-3xl opacity-20"></div>
        
        <div class="relative p-12 md:p-16 text-white text-center rounded-3xl">
          <div class="max-w-4xl mx-auto">
            <h2 class="text-4xl md:text-5xl font-display font-bold mb-8">
              ¡Gracias por Creer en Nuestros Niños! 🌟
            </h2>
            <p class="text-xl md:text-2xl text-white/90 mb-8 leading-relaxed">
              Cada sonrisa, cada gol, cada momento de alegría es posible gracias a su invaluable apoyo. 
              Juntos estamos construyendo el futuro del fútbol colombiano.
            </p>
            
            <!-- Valores que promovemos -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-12">
              <div class="bg-white/20 backdrop-blur-sm rounded-2xl p-6 hover:bg-white/30 transition-all duration-300 hover:scale-105">
                <div class="text-4xl mb-3">🤝</div>
                <div class="font-semibold">Trabajo en Equipo</div>
              </div>
              <div class="bg-white/20 backdrop-blur-sm rounded-2xl p-6 hover:bg-white/30 transition-all duration-300 hover:scale-105">
                <div class="text-4xl mb-3">💪</div>
                <div class="font-semibold">Disciplina</div>
              </div>
              <div class="bg-white/20 backdrop-blur-sm rounded-2xl p-6 hover:bg-white/30 transition-all duration-300 hover:scale-105">
                <div class="text-4xl mb-3">⚡</div>
                <div class="font-semibold">Fair Play</div>
              </div>
              <div class="bg-white/20 backdrop-blur-sm rounded-2xl p-6 hover:bg-white/30 transition-all duration-300 hover:scale-105">
                <div class="text-4xl mb-3">🌟</div>
                <div class="font-semibold">Excelencia</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Llamada a la Acción Innovadora -->
      <section class="text-center">
        <div class="bg-white rounded-3xl shadow-neomorphism p-12 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-primary-500 via-secondary-500 to-accent-500"></div>
          
          <h3 class="text-3xl font-display font-bold text-gray-900 mb-6">
            ¿Quieres ser parte de esta gran familia? 🚀
          </h3>
          <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
            Únete a nosotros y ayuda a transformar vidas a través del deporte. 
            Cada apoyo cuenta, cada gesto importa.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
            <a href="mailto:cdlpaisitas@gmail.com" 
               class="group inline-flex items-center px-8 py-4 bg-gradient-to-r from-primary-600 to-secondary-600 text-white font-semibold rounded-2xl hover:from-primary-700 hover:to-secondary-700 transition-all duration-300 hover:scale-105 hover:shadow-lg">
              <svg class="w-6 h-6 mr-3 group-hover:animate-bounce" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
              </svg>
              Conversemos por Email
            </a>
            
            <a href="https://wa.me/573117736767" 
               target="_blank"
               class="group inline-flex items-center px-8 py-4 bg-gradient-to-r from-green-500 to-green-600 text-white font-semibold rounded-2xl hover:from-green-600 hover:to-green-700 transition-all duration-300 hover:scale-105 hover:shadow-lg">
              <svg class="w-6 h-6 mr-3 group-hover:animate-pulse" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
              </svg>
              WhatsApp Directo
            </a>
          </div>
          
          <div class="mt-8 text-sm text-gray-500">
            <p>📞 (604) 2602853 • 🌐 www.festivaldefestivales.com</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const response = await fetch('/data/sponsors.json');
      const data = await response.json();
      
      const mainSponsors = document.getElementById('main-sponsors');
      const institutionalSponsors = document.getElementById('institutional-sponsors');
      const sportsSponsors = document.getElementById('sports-sponsors');
      
      if (!mainSponsors || !institutionalSponsors || !sportsSponsors) return;

      // Filtrar aliados por categoría
      const mainSponsorsData = data.sponsors.filter(sponsor => sponsor.category === 'Patrocinador Principal');
      const institutionalSponsorsData = data.sponsors.filter(sponsor => sponsor.category === 'Institucional');
      const sportsSponsorsData = data.sponsors.filter(sponsor => sponsor.category === 'Deportivo');

      // Renderizar aliados principales con diseño innovador
      mainSponsors.innerHTML = mainSponsorsData.map((sponsor, index) => `
        <div class="group relative" style="animation-delay: ${index * 0.2}s">
          <div class="absolute inset-0 bg-gradient-to-br from-primary-200 to-secondary-200 rounded-3xl opacity-0 group-hover:opacity-100 transition-all duration-500 blur-xl"></div>
          <a href="${sponsor.url}" 
             target="_blank" 
             rel="noopener noreferrer"
             class="relative block bg-white rounded-3xl shadow-neomorphism p-8 hover:shadow-xl transition-all duration-500 hover:scale-105 hover:-rotate-1 overflow-hidden">
            
            <!-- Decorative elements -->
            <div class="absolute top-0 right-0 w-20 h-20 bg-gradient-to-br from-yellow-200 to-orange-200 rounded-full opacity-20 -translate-y-10 translate-x-10 group-hover:scale-150 transition-transform duration-700"></div>
            <div class="absolute bottom-0 left-0 w-16 h-16 bg-gradient-to-br from-blue-200 to-purple-200 rounded-full opacity-20 translate-y-8 -translate-x-8 group-hover:scale-150 transition-transform duration-700"></div>
            
            <div class="relative text-center">
              <div class="w-32 h-32 mx-auto mb-6 bg-gradient-to-br from-gray-50 to-gray-100 rounded-2xl flex items-center justify-center overflow-hidden shadow-neomorphism-inset group-hover:shadow-lg transition-all duration-300">
                <img src="${sponsor.logo}" 
                     alt="Logo ${sponsor.name}"
                     class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-500">
              </div>
              
              <h3 class="text-2xl font-display font-bold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors duration-300">
                ${sponsor.name}
              </h3>
              
              <div class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-primary-100 to-secondary-100 rounded-full">
                <span class="text-sm font-semibold text-primary-700">🤝 Aliado Estratégico</span>
              </div>
              
              <!-- Hover effect -->
              <div class="absolute inset-0 bg-gradient-to-t from-primary-600/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-3xl"></div>
            </div>
          </a>
        </div>
      `).join('');

      // Renderizar aliados institucionales con cards flotantes
      institutionalSponsors.innerHTML = institutionalSponsorsData.map((sponsor, index) => `
        <div class="group relative" style="animation-delay: ${index * 0.1}s">
          <a href="${sponsor.url}" 
             target="_blank" 
             rel="noopener noreferrer"
             class="block bg-white rounded-2xl shadow-neomorphism p-6 hover:shadow-lg transition-all duration-300 hover:scale-110 hover:rotate-3 w-40">
            
            <div class="text-center">
              <div class="w-20 h-20 mx-auto mb-4 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl flex items-center justify-center overflow-hidden group-hover:bg-gradient-to-br group-hover:from-blue-100 group-hover:to-indigo-100 transition-all duration-300">
                <img src="${sponsor.logo}" 
                     alt="Logo ${sponsor.name}"
                     class="w-full h-full object-contain group-hover:scale-125 transition-transform duration-300">
              </div>
              
              <h4 class="text-sm font-semibold text-gray-900 group-hover:text-blue-600 transition-colors duration-300">
                ${sponsor.name}
              </h4>
              
              <div class="mt-2 text-xs text-blue-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                🏛️ Apoyo Institucional
              </div>
            </div>
          </a>
        </div>
      `).join('');

      // Renderizar familia deportiva
      sportsSponsors.innerHTML = sportsSponsorsData.map((sponsor, index) => `
        <div class="group" style="animation-delay: ${index * 0.1}s">
          <a href="${sponsor.url}" 
             target="_blank" 
             rel="noopener noreferrer"
             class="block bg-white rounded-xl shadow-neomorphism-sm p-6 hover:shadow-md transition-all duration-300 hover:scale-105 hover:-rotate-2">
            
            <div class="text-center">
              <div class="w-16 h-16 mx-auto mb-4 bg-gradient-to-br from-green-50 to-emerald-50 rounded-lg flex items-center justify-center overflow-hidden group-hover:bg-gradient-to-br group-hover:from-green-100 group-hover:to-emerald-100 transition-all duration-300">
                <img src="${sponsor.logo}" 
                     alt="Logo ${sponsor.name}"
                     class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-300">
              </div>
              
              <h4 class="text-sm font-semibold text-gray-900 group-hover:text-green-600 transition-colors duration-300">
                ${sponsor.name}
              </h4>
              
              <div class="mt-2 text-xs text-green-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                ⚽ Pasión Deportiva
              </div>
            </div>
          </a>
        </div>
      `).join('');

      // Agregar animaciones de entrada
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.style.animation = 'fadeInUp 0.6s ease-out forwards';
          }
        });
      }, observerOptions);

      // Observar todos los elementos animables
      document.querySelectorAll('#main-sponsors > div, #institutional-sponsors > div, #sports-sponsors > div').forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(30px)';
        observer.observe(el);
      });

    } catch (error) {
      console.error('Error loading sponsors:', error);
      const errorMessage = `
        <div class="text-center py-12">
          <div class="text-red-500 mb-4">
            <svg class="w-12 h-12 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
          </div>
          <p class="text-red-600 font-semibold">Error al cargar nuestros aliados</p>
          <p class="text-gray-600 mt-2">Por favor, intenta recargar la página</p>
          <button onclick="window.location.reload()" class="mt-4 px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
            Recargar
          </button>
        </div>
      `;
      document.getElementById('main-sponsors').innerHTML = errorMessage;
    }
  });
</script>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Animaciones adicionales */
  .group:hover .animate-bounce {
    animation: bounce 1s infinite;
  }
  
  .group:hover .animate-pulse {
    animation: pulse 2s infinite;
  }
  
  .group:hover .animate-spin {
    animation: spin 2s linear infinite;
  }
</style>