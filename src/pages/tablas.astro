---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Tablas de Posiciones - Festival BabyFútbol Colanta 2025" currentPage="tablas">
  <div class="py-8 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-3xl md:text-4xl font-display font-bold text-gray-900 mb-2">
          Tablas de Posiciones
        </h1>
        <p class="text-base text-gray-600">
          Clasificación actual por grupos — Festival BabyFútbol Colanta 2025
        </p>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap justify-center gap-2 mb-6" id="group-filter">
        <button class="px-4 py-2 rounded-lg bg-primary-600 text-white filter-btn active" data-group="all">Todos</button>
      </div>

      <!-- Tables Container -->
      <div id="tables-container" class="grid gap-8"></div>
    </div>
  </div>

  <style>
    .shadow-neomorphism { box-shadow: 10px 10px 24px rgba(15,23,42,0.06), -6px -6px 18px rgba(255,255,255,0.6); }
    .table-head th { position: sticky; top: 0; background: rgba(255,255,255,0.95); backdrop-filter: blur(6px); z-index: 1; }
  </style>

  <script type="module">
    (async () => {
      // CONFIG: ajusta la ruta de los escudos si los tienes en otra carpeta/CDN
      const ESCUDO_PATH = '/assets/escudos/'; // <<-- cambia aquí si necesitas
      const ESCUDO_FALLBACK = ESCUDO_PATH + 'default.webp';

      // Colores por grupo (hex) - usado para gradiente del header
      const GROUP_COLORS = {
        'A': ['#ef4444','#dc2626'],
        'B': ['#3b82f6','#2563eb'],
        'C': ['#10b981','#059669'],
        'D': ['#f59e0b','#d97706'],
        'E': ['#8b5cf6','#7c3aed'],
        'F': ['#ec4899','#db2777'],
        'default': ['#9ca3af','#6b7280']
      };

      function getGradientForGroup(groupName) {
        if (!groupName) return GROUP_COLORS.default;
        const key = groupName.length === 1 ? groupName.toUpperCase() : (GROUP_COLORS[groupName] ? groupName : groupName[0]);
        return GROUP_COLORS[key] || GROUP_COLORS.default;
      }

      function isNumeric(n) { return !isNaN(Number(n)); }

      // Safe resolver para nombre de escudo: prioriza teamsMap -> entry.escudo -> genera a partir del nombre
      function safeEscudoFile(teamEntry, standingEntry) {
        // teamEntry: { name, escudo, ... } o undefined
        // standingEntry: objeto original en standings[].teams[]
        if (teamEntry && teamEntry.escudo) return teamEntry.escudo;
        if (standingEntry && standingEntry.escudo) return standingEntry.escudo;
        const name = (teamEntry && teamEntry.name) || standingEntry && standingEntry.team || '';
        const first = String(name).trim().split(/\s+/)[0].replace(/\./g,'') || 'unknown';
        return `${slugify(first)}.webp`;
      }

      function slugify(text) {
        return String(text).toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // quitar acentos
          .replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      }

      try {
        // Carga el JSON optimizado (espera keys: "teams": {...}, "standings": [...])
        const resp = await fetch('/data/standings.json');
        if (!resp.ok) throw new Error('standings.json not found');
        const data = await resp.json();

        const teamsMap = (data.teams && typeof data.teams === 'object') ? data.teams : {};
        const standings = Array.isArray(data.standings) ? data.standings : [];

        const groupFilter = document.getElementById('group-filter');
        const tablesContainer = document.getElementById('tables-container');
        if (!groupFilter || !tablesContainer) return;

        // Crear botones según grupos (evitar duplicados)
        const groupNames = standings.map(s => s.group);
        const uniqueGroups = [...new Set(groupNames)];
        uniqueGroups.forEach(g => {
          const btn = document.createElement('button');
          btn.className = 'px-3 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition-colors filter-btn';
          btn.dataset.group = g;
          btn.textContent = g.length <= 3 ? `Grupo ${g}` : g;
          groupFilter.appendChild(btn);
        });

        // Render principal: recibe selectedGroup = 'all' o group exacto
        function showTables(selectedGroup = 'all') {
          const toShow = selectedGroup === 'all' ? standings : standings.filter(s => s.group === selectedGroup);
          tablesContainer.className = toShow.length > 1 ? 'grid gap-8 lg:grid-cols-2' : 'grid gap-8';

          tablesContainer.innerHTML = toShow.map(groupStanding => {
            const teams = Array.isArray(groupStanding.teams) ? groupStanding.teams : [];
            const [c1, c2] = getGradientForGroup(groupStanding.group);
            const headerStyle = `background: linear-gradient(90deg, ${c1} 0%, ${c2} 100%);`;

            return `
              <section class="bg-white rounded-2xl shadow-neomorphism overflow-hidden">
                <header class="p-5 text-white" style="${headerStyle}">
                  <h2 class="text-xl md:text-2xl font-display font-bold">Grupo ${groupStanding.group}</h2>
                </header>

                <div class="overflow-x-auto">
                  <table class="min-w-full text-sm">
                    <thead class="table-head">
                      <tr class="bg-gray-50">
                        <th class="px-4 py-3 text-left w-12">#</th>
                        <th class="px-4 py-3 text-left">Equipo</th>
                        <th class="px-2 py-3 text-center">PJ</th>
                        <th class="px-2 py-3 text-center">PG</th>
                        <th class="px-2 py-3 text-center">PE</th>
                        <th class="px-2 py-3 text-center">PP</th>
                        <th class="px-2 py-3 text-center">GF</th>
                        <th class="px-2 py-3 text-center">GC</th>
                        <th class="px-2 py-3 text-center">DIF</th>
                        <th class="px-2 py-3 text-center">Pts</th>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-100">
                      ${teams.map(teamEntry => {
                        // Compatibilidad: teamEntry puede tener teamId o team + escudo
                        const teamId = teamEntry.teamId || null;
                        const teamObj = teamId ? teamsMap[teamId] : null;
                        const teamName = (teamObj && teamObj.name) || teamEntry.team || '—';
                        const escudoFile = safeEscudoFile(teamObj, teamEntry);
                        const escudoUrl =  escudoFile;
                        const pj = teamEntry.pj ?? 0;
                        const pg = teamEntry.pg ?? 0;
                        const pe = teamEntry.pe ?? 0;
                        const pp = teamEntry.pp ?? 0;
                        const gf = teamEntry.gf ?? 0;
                        const gc = teamEntry.gc ?? 0;
                        const dif = (typeof teamEntry.dif !== 'undefined') ? teamEntry.dif : (Number(gf) - Number(gc));
                        const pts = teamEntry.pts ?? 0;
                        const pos = teamEntry.position;
                        const posNum = isNumeric(pos) ? Number(pos) : null;
                        const medalClasses = posNum === 1 ? 'bg-yellow-400 text-yellow-900' : posNum === 2 ? 'bg-gray-300 text-gray-900' : 'bg-gray-100 text-gray-700';

                        return `
                          <tr class="hover:bg-gray-50 transition-colors ${posNum && posNum <= 2 ? 'bg-green-50' : ''}">
                            <td class="px-4 py-3 whitespace-nowrap">
                              <div class="flex items-center">
                                <span class="w-7 h-7 flex items-center justify-center rounded-full text-xs font-bold ${medalClasses}">${pos}</span>
                              </div>
                            </td>

                            <td class="px-4 py-3">
                              <div class="flex items-center">
                                <img src="${escudoUrl}" onerror="this.onerror=null;this.src='${ESCUDO_FALLBACK}'" alt="${teamName} escudo" class="w-8 h-8 rounded-full mr-3 object-cover" />
                                <div class="leading-5">
                                  <div class="text-sm font-medium text-gray-900">${teamName}</div>
                                  <div class="text-xs text-gray-500">${pg}G · ${pe}E · ${pp}P</div>
                                </div>
                              </div>
                            </td>

                            <td class="px-2 py-3 text-center">${pj}</td>
                            <td class="px-2 py-3 text-center font-semibold text-green-600">${pg}</td>
                            <td class="px-2 py-3 text-center font-semibold text-yellow-600">${pe}</td>
                            <td class="px-2 py-3 text-center font-semibold text-red-600">${pp}</td>
                            <td class="px-2 py-3 text-center font-semibold text-blue-600">${gf}</td>
                            <td class="px-2 py-3 text-center text-red-500">${gc}</td>
                            <td class="px-2 py-3 text-center font-semibold ${dif > 0 ? 'text-green-600' : dif < 0 ? 'text-red-600' : 'text-gray-600'}">
                              ${dif > 0 ? '+' : ''}${dif}
                            </td>
                            <td class="px-2 py-3 text-center">
                              <span class="px-2 py-1 text-sm font-bold bg-primary-100 text-primary-800 rounded-full">${pts}</span>
                            </td>
                          </tr>`;
                      }).join('')}
                    </tbody>
                  </table>
                </div>

                <footer class="p-4 bg-gray-50 border-t">
                  <div class="flex flex-wrap gap-4 text-xs text-gray-600">
                    <div class="flex items-center"><div class="w-3 h-3 bg-green-100 rounded mr-2"></div><span>Clasifican</span></div>
                    <div class="flex items-center">PJ: Partidos Jugados</div>
                    <div class="flex items-center">PG: Ganados</div>
                    <div class="flex items-center">PE: Empatados</div>
                    <div class="flex items-center">PP: Perdidos</div>
                  </div>
                </footer>
              </section>
            `;
          }).join('');
        }

        // Render inicial
        showTables();

        // Delegación para filtro
        groupFilter.addEventListener('click', (ev) => {
          const btn = ev.target.closest('.filter-btn');
          if (!btn) return;

          // reset clases
          groupFilter.querySelectorAll('.filter-btn').forEach(b => {
            b.classList.remove('bg-primary-600','text-white','active');
            b.classList.add('bg-gray-200','text-gray-800');
          });

          btn.classList.remove('bg-gray-200','text-gray-800');
          btn.classList.add('bg-primary-600','text-white','active');

          const group = btn.dataset.group || 'all';
          showTables(group);
        });

      } catch (err) {
        console.error('Error cargando standings.json', err);
        const container = document.getElementById('tables-container');
        if (container) container.innerHTML = '<div class="text-center py-12"><p class="text-red-600">Error cargando tablas. Revisa /data/standings.json</p></div>';
      }
    })();
  </script>
</BaseLayout>
