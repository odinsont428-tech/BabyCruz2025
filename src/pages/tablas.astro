---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Tablas de Posiciones - Festival BabyFútbol Colanta 2025" currentPage="tablas">
  <div class="py-8 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-gray-900 mb-4">
          Tablas de Posiciones
        </h1>
        <p class="text-xl text-gray-600">
          Clasificación actual por grupos del torneo
        </p>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap justify-center gap-2 mb-8" id="group-filter">
        <button class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors filter-btn active" data-group="all">
          Todos los Grupos
        </button>
      </div>

      <!-- Tables Container -->
      <div id="tables-container" class="grid gap-8">
        <!-- Las tablas se cargarán aquí -->
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const [standingsResponse, groupsResponse] = await Promise.all([
        fetch('/data/standings.json'),
        fetch('/data/groups.json')
      ]);
      
      const standingsData = await standingsResponse.json();
      const groupsData = await groupsResponse.json();
      
      const groupFilter = document.getElementById('group-filter');
      const tablesContainer = document.getElementById('tables-container');
      
      if (!groupFilter || !tablesContainer) return;

      // Crear botones de filtro por grupo
      groupsData.groups.forEach(group => {
        const button = document.createElement('button');
        button.className = 'px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors filter-btn';
        button.textContent = group.name;
        button.dataset.group = group.name;
        groupFilter.appendChild(button);
      });

      // Función para obtener color del grupo
      function getGroupColor(groupName) {
        const groupColors = {
          'GRUPO A': 'red',
          'GRUPO B': 'blue', 
          'GRUPO C': 'green',
          'GRUPO D': 'yellow',
          'GRUPO E': 'purple',
          'GRUPO F': 'pink'
        };
        return groupColors[groupName] || 'gray';
      }

      // Función para mostrar tablas
      function showTables(selectedGroup = 'all') {
        const tablesToShow = selectedGroup === 'all' ? 
          standingsData.standings : 
          standingsData.standings.filter(standing => standing.group === selectedGroup.split(' ')[1]);
        
        const gridClass = selectedGroup === 'all' ? 
          'grid gap-8 lg:grid-cols-2' : 'grid gap-8';
        
        tablesContainer.className = gridClass;
        
        tablesContainer.innerHTML = tablesToShow.map(groupStanding => {
          const color = getGroupColor(`GRUPO ${groupStanding.group}`);
          
          return `
            <div class="bg-white rounded-2xl shadow-neomorphism overflow-hidden">
              <!-- Header del grupo -->
              <div class="bg-gradient-to-r from-${color}-500 to-${color}-600 text-white p-6">
                <h2 class="text-2xl font-display font-bold">GRUPO ${groupStanding.group}</h2>
              </div>
              
              <!-- Tabla -->
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead class="bg-gray-50">
                    <tr>
                      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">#</th>
                      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Equipo</th>
                      <th class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">PJ</th>
                      <th class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">PG</th>
                      <th class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">PE</th>
                      <th class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">PP</th>
                      <th class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">GF</th>
                      <th class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">GC</th>
                      <th class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">DIF</th>
                      <th class="px-2 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Pts</th>
                    </tr>
                  </thead>
                  <tbody class="bg-white divide-y divide-gray-200">
                    ${groupStanding.teams.map(team => `
                      <tr class="hover:bg-gray-50 transition-colors ${team.position <= 2 ? 'bg-green-50' : ''}">
                        <td class="px-4 py-4 whitespace-nowrap">
                          <div class="flex items-center">
                            <span class="w-6 h-6 flex items-center justify-center rounded-full text-xs font-bold ${
                              team.position === 1 ? 'bg-yellow-400 text-yellow-900' :
                              team.position === 2 ? 'bg-gray-300 text-gray-900' :
                              team.position <= 2 ? 'bg-green-100 text-green-800' :
                              'bg-gray-100 text-gray-600'
                            }">
                              ${team.position}
                            </span>
                          </div>
                        </td>
                        <td class="px-4 py-4">
                          <div class="text-sm font-medium text-gray-900">${team.team}</div>
                        </td>
                        <td class="px-2 py-4 text-center text-sm text-gray-900">${team.pj}</td>
                        <td class="px-2 py-4 text-center text-sm text-green-600 font-semibold">${team.pg}</td>
                        <td class="px-2 py-4 text-center text-sm text-yellow-600 font-semibold">${team.pe}</td>
                        <td class="px-2 py-4 text-center text-sm text-red-600 font-semibold">${team.pp}</td>
                        <td class="px-2 py-4 text-center text-sm text-blue-600 font-semibold">${team.gf}</td>
                        <td class="px-2 py-4 text-center text-sm text-red-500">${team.gc}</td>
                        <td class="px-2 py-4 text-center text-sm font-semibold ${team.dif > 0 ? 'text-green-600' : team.dif < 0 ? 'text-red-600' : 'text-gray-600'}">
                          ${team.dif > 0 ? '+' : ''}${team.dif}
                        </td>
                        <td class="px-2 py-4 text-center">
                          <span class="px-2 py-1 text-sm font-bold bg-primary-100 text-primary-800 rounded-full">
                            ${team.pts}
                          </span>
                        </td>
                      </tr>
                    `).join('')}
                  </tbody>
                </table>
              </div>
              
              <!-- Leyenda -->
              <div class="p-4 bg-gray-50 border-t">
                <div class="flex flex-wrap gap-4 text-xs text-gray-600">
                  <div class="flex items-center">
                    <div class="w-3 h-3 bg-green-100 rounded mr-2"></div>
                    <span>Clasifican a octavos</span>
                  </div>
                  <div class="flex items-center">
                    <span class="mr-2">PJ: Partidos Jugados</span>
                  </div>
                  <div class="flex items-center">
                    <span class="mr-2">PG: Partidos Ganados</span>
                  </div>
                  <div class="flex items-center">
                    <span class="mr-2">PE: Partidos Empatados</span>
                  </div>
                  <div class="flex items-center">
                    <span>PP: Partidos Perdidos</span>
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      // Mostrar todas las tablas inicialmente
      showTables();

      // Event listeners para los botones de filtro
      groupFilter.addEventListener('click', (e) => {
        if (e.target.classList.contains('filter-btn')) {
          // Remover clase active de todos los botones
          groupFilter.querySelectorAll('.filter-btn').forEach(btn => {
            btn.classList.remove('active', 'bg-primary-600', 'text-white');
            btn.classList.add('bg-gray-200', 'text-gray-700');
          });
          
          // Agregar clase active al botón clickeado
          e.target.classList.add('active', 'bg-primary-600', 'text-white');
          e.target.classList.remove('bg-gray-200', 'text-gray-700');
          
          // Mostrar tablas filtradas
          showTables(e.target.dataset.group);
        }
      });

    } catch (error) {
      console.error('Error loading standings:', error);
      document.getElementById('tables-container').innerHTML = `
        <div class="text-center py-12">
          <p class="text-red-600">Error al cargar las tablas de posiciones. Por favor, intenta nuevamente.</p>
        </div>
      `;
    }
  });
</script>
</BaseLayout>