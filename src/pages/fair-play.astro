---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Tabla Juego Limpio - Festival BabyFútbol Colanta 2025" currentPage="fair-play">
  <div class="py-8 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-gray-900 mb-4">
          Tabla de Juego Limpio
        </h1>
        <p class="text-xl text-gray-600">
          Registro de tarjetas y expulsiones acumuladas en el torneo
        </p>
      </div>

      <!-- Fair Play Table -->
      <div class="bg-white rounded-2xl shadow-neomorphism overflow-hidden mb-8">
        <!-- Header -->
        <div class="bg-gradient-to-r from-success-600 to-success-700 text-black p-6">
          <h2 class="text-2xl font-display font-bold flex items-center">
            <svg class="w-8 h-8 mr-3" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"/>
            </svg>
            Clasificación de Juego Limpio
          </h2>
          <p class="text-success-100 mt-2">Menos puntos negativos = Mejor fair play</p>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
          <table class="w-full" id="fair-play-table">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Posición</th>
                <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Equipo</th>
                <th class="px-4 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                  <div class="flex items-center justify-center gap-2">
                    ⚠️ Amarillas
                  </div>
                </th>
                <th class="px-4 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                  <div class="flex items-center justify-center gap-2">
                    ⛔ Rojas
                  </div>
                </th>
                <th class="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Puntos</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200" id="fair-play-tbody">
              <!-- Los datos se cargarán aquí -->
            </tbody>
          </table>
        </div>

        <!-- Explanation -->
        <div class="p-6 bg-gray-50 border-t">
          <h4 class="font-semibold text-gray-900 mb-2">Sistema de Puntuación:</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>• Tarjeta Amarilla (jugador): -5 puntos</li>
            <li>• Expulsión (jugador): -10 puntos</li>
            <li>• Faltas del cuerpo técnico: también suman puntos negativos</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const response = await fetch('/data/fair-play.json');
      const data = await response.json();

      const tbody = document.getElementById('fair-play-tbody');
      if (!tbody) return;

      // Reglas de puntuación
      const POINTS = {
        yellow: -5,
        red: -10
      };

      // Calcular puntos por equipo
      const fairPlayData = data.fairPlay.map(team => {
        const points = (team.yellowCards * POINTS.yellow) + (team.redCards * POINTS.red);
        return { ...team, points };
      });

      // Ordenar (mejor es menos negativo)
      fairPlayData.sort((a, b) => b.points - a.points);

      // Renderizar tabla
      tbody.innerHTML = fairPlayData.map((team, i) => `
        <tr class="hover:bg-gray-50 transition-colors ${i === 0 ? 'bg-green-50' : ''}">
          <td class="px-6 py-4 font-bold text-lg">${i + 1}</td>
          <td class="px-6 py-4">
            <div class="text-lg font-semibold text-gray-900">${team.team}</div>
          </td>
          <td class="px-4 py-4 text-center">
            <span class="flex items-center justify-center gap-1 text-yellow-600 font-bold">
              ⚠️ ${team.yellowCards}
            </span>
          </td>
          <td class="px-4 py-4 text-center">
            <span class="flex items-center justify-center gap-1 text-red-600 font-bold">
              ⛔ ${team.redCards}
            </span>
          </td>
          <td class="px-6 py-4 text-center">
            <span class="px-4 py-2 text-lg font-bold rounded-full ${
              team.points >= -10 ? 'bg-green-100 text-green-800' :
              team.points >= -20 ? 'bg-yellow-100 text-yellow-800' :
              'bg-red-100 text-red-800'
            }">
              ${team.points}
            </span>
          </td>
        </tr>
      `).join('');

    } catch (error) {
      console.error('Error loading fair play data:', error);
      document.getElementById('fair-play-tbody').innerHTML = `
        <tr>
          <td colspan="5" class="px-6 py-12 text-center text-red-600">
            Error al cargar la tabla de juego limpio. Por favor, intenta nuevamente.
          </td>
        </tr>
      `;
    }
  });
</script>
