---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Tabla Juego Limpio - Festival BabyFútbol Colanta 2025" currentPage="fair-play">
  <div class="py-8 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-gray-900 mb-4">
          Tabla de Juego Limpio
        </h1>
        <p class="text-xl text-gray-600">
          Reconocimiento a los equipos que promueven el fair play en el torneo
        </p>
      </div>

      <!-- Fair Play Table -->
      <div class="bg-white rounded-2xl shadow-neomorphism overflow-hidden mb-8">
        <!-- Header -->
        <div class="bg-gradient-to-r from-success-600 to-success-700 text-white p-6">
          <h2 class="text-2xl font-display font-bold flex items-center">
            <svg class="w-8 h-8 mr-3" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"/>
            </svg>
            Clasificación de Juego Limpio
          </h2>
          <p class="text-success-100 mt-2">Sistema de puntuación: Menos puntos = Mejor fair play</p>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
          <table class="w-full" id="fair-play-table">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Posición</th>
                <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Equipo</th>
                <th class="px-4 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                  <div class="flex items-center justify-center">
                    <div class="w-4 h-4 bg-yellow-400 rounded mr-2"></div>
                    Amarillas
                  </div>
                </th>
                <th class="px-4 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                  <div class="flex items-center justify-center">
                    <div class="w-4 h-4 bg-red-500 rounded mr-2"></div>
                    Rojas
                  </div>
                </th>
                <th class="px-6 py-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Puntos Fair Play</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200" id="fair-play-tbody">
              <!-- Los datos se cargarán aquí -->
            </tbody>
          </table>
        </div>

        <!-- Explanation -->
        <div class="p-6 bg-gray-50 border-t">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">Sistema de Puntuación:</h4>
              <ul class="text-sm text-gray-600 space-y-1">
                <li>• Tarjeta Amarilla: -1 punto</li>
                <li>• Tarjeta Roja: -5 puntos</li>
                <li>• Puntuación base: 20 puntos</li>
              </ul>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">Reconocimientos:</h4>
              <ul class="text-sm text-gray-600 space-y-1">
                <li>🏆 1° lugar: Premio Fair Play del torneo</li>
                <li>🥈 2° lugar: Mención especial</li>
                <li>🥉 3° lugar: Reconocimiento deportivo</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Achievement Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="achievement-cards">
        <!-- Las tarjetas de logros se cargarán aquí -->
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const response = await fetch('/data/fair-play.json');
      const data = await response.json();
      
      const tbody = document.getElementById('fair-play-tbody');
      const achievementCards = document.getElementById('achievement-cards');
      
      if (!tbody || !achievementCards) return;

      // Renderizar tabla de fair play
      tbody.innerHTML = data.fairPlay.map(team => `
        <tr class="hover:bg-gray-50 transition-colors ${team.position <= 3 ? 'bg-green-50' : ''}">
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="flex items-center">
              ${team.position === 1 ? `
                <div class="w-10 h-10 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M5 16L3 5L8.5 12L12 4L15.5 12L21 5L19 16H5Z"/>
                  </svg>
                </div>
              ` : team.position === 2 ? `
                <div class="w-10 h-10 bg-gradient-to-br from-gray-300 to-gray-500 rounded-full flex items-center justify-center">
                  <span class="text-white font-bold text-lg">${team.position}</span>
                </div>
              ` : team.position === 3 ? `
                <div class="w-10 h-10 bg-gradient-to-br from-orange-400 to-orange-600 rounded-full flex items-center justify-center">
                  <span class="text-white font-bold text-lg">${team.position}</span>
                </div>
              ` : `
                <div class="w-10 h-10 bg-gradient-to-br from-success-400 to-success-600 rounded-full flex items-center justify-center">
                  <span class="text-white font-bold text-lg">${team.position}</span>
                </div>
              `}
            </div>
          </td>
          <td class="px-6 py-4">
            <div class="text-lg font-semibold text-gray-900">${team.team}</div>
          </td>
          <td class="px-4 py-4 text-center">
            <div class="flex items-center justify-center">
              <div class="w-6 h-6 bg-yellow-400 rounded mr-2 flex items-center justify-center">
                <span class="text-xs font-bold text-yellow-900">${team.yellowCards}</span>
              </div>
              <span class="text-lg font-semibold text-yellow-600">${team.yellowCards}</span>
            </div>
          </td>
          <td class="px-4 py-4 text-center">
            <div class="flex items-center justify-center">
              <div class="w-6 h-6 bg-red-500 rounded mr-2 flex items-center justify-center">
                <span class="text-xs font-bold text-white">${team.redCards}</span>
              </div>
              <span class="text-lg font-semibold text-red-600">${team.redCards}</span>
            </div>
          </td>
          <td class="px-6 py-4 text-center">
            <span class="px-4 py-2 text-xl font-bold rounded-full ${
              team.position === 1 ? 'bg-yellow-100 text-yellow-800' :
              team.position === 2 ? 'bg-gray-100 text-gray-800' :
              team.position === 3 ? 'bg-orange-100 text-orange-800' :
              'bg-success-100 text-success-800'
            }">
              ${team.points}
            </span>
          </td>
        </tr>
      `).join('');

      // Obtener los 3 primeros lugares
      const topThree = data.fairPlay.slice(0, 3);
      
      // Renderizar tarjetas de logros
      achievementCards.innerHTML = topThree.map((team, index) => {
        const awards = ['🏆 Premio Fair Play', '🥈 Mención Especial', '🥉 Reconocimiento'];
        const colors = ['from-yellow-400 to-yellow-600', 'from-gray-300 to-gray-500', 'from-orange-400 to-orange-600'];
        
        return `
          <div class="bg-gradient-to-br ${colors[index]} rounded-2xl p-6 text-white shadow-neomorphism transform hover:scale-105 transition-transform duration-300">
            <div class="text-center">
              <div class="text-4xl mb-3">${awards[index].split(' ')[0]}</div>
              <h3 class="text-xl font-bold mb-2">${team.team}</h3>
              <p class="text-sm opacity-90 mb-4">${awards[index]}</p>
              <div class="bg-white bg-opacity-20 rounded-lg p-3">
                <div class="text-3xl font-bold">${team.points}</div>
                <div class="text-sm opacity-80">Puntos Fair Play</div>
              </div>
            </div>
          </div>
        `;
      }).join('');

    } catch (error) {
      console.error('Error loading fair play data:', error);
      document.getElementById('fair-play-tbody').innerHTML = `
        <tr>
          <td colspan="5" class="px-6 py-12 text-center text-red-600">
            Error al cargar la tabla de juego limpio. Por favor, intenta nuevamente.
          </td>
        </tr>
      `;
    }
  });
</script>
</BaseLayout>